# ── Base de datos ────────────────────────────────────────────────
# El rol de la aplicacion NO es superusuario: la migracion de constraints
# le revoca UPDATE/DELETE sobre audit_logs y data_consents.
POSTGRES_USER=visionos_app
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=visionos
DATABASE_URL=postgresql://visionos_app:cambiar_en_produccion@localhost:5432/visionos?schema=public
# Las migraciones quieren una conexion de sesion, no agrupada.
#
# En teoria es el endpoint de Neon SIN "-pooler". En la practica ese endpoint
# NO le responde al motor de migraciones de Prisma —el cliente si conecta y el
# puerto 5432 esta abierto, pero `migrate deploy` da P1001— asi que en
# desarrollo apunta al mismo agrupado, que si funciona.
#
# El precio: Prisma toma un lock de aviso al migrar y pgbouncer en modo
# transaccion no lo soporta, de modo que dos migraciones simultaneas podrian
# entrelazarse. Con un desarrollador y un despliegue no ocurre, y en el VPS
# —Postgres local, sin pooler— el problema desaparece: alli las dos URLs son
# la misma y directa.
DIRECT_DATABASE_URL=postgresql://visionos_app:cambiar_en_produccion@localhost:5432/visionos?schema=public

# ── API ──────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
# Se inyecta en el build; /health lo devuelve para verificar que el deploy entro.
GIT_SHA=local

JWT_SECRET=cambiar_en_produccion_minimo_32_caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar_en_produccion_otro_distinto_32_car
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGINS=http://localhost:3000

# ── Web ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Redis / colas ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── WhatsApp (E2) ────────────────────────────────────────────────
# Version PINNEADA sin caret a proposito: Baileys es ingenieria inversa
# y un RC distinto puede tumbar la sesion. Ver R1 del plan.
WHATSAPP_MAX_SESSIONS=4
# Clave AES-256-GCM del auth state de Baileys guardado en Postgres.
# Generar con: openssl rand -hex 32
WHATSAPP_AUTH_ENCRYPTION_KEY=

# ── IA (E5) ──────────────────────────────────────────────────────
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Corte duro mensual en USD: al superarlo la IA degrada a "un humano
# te responde en un momento" en vez de seguir gastando.
AI_MONTHLY_BUDGET_USD=60
