// ═══════════════════════════════════════════════════════════════════
// RED FISICA
// ═══════════════════════════════════════════════════════════════════

model Site {
  id      String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code    String @unique
  name    String
  city    String
  address String

  /// DIVIPOLA. Gancho RIPS: nullable hoy, obligatorio antes de facturar.
  municipalityCode String? @map("municipality_code") @db.VarChar(5)
  /// Codigo de habilitacion REPS de la sede. Lo pedira RIPS.
  habilitationCode String? @map("habilitation_code")

  phone        String?
  timezone     String  @default("America/Bogota")
  /// Horario de puertas, no de agenda: {"mon":[["07:00","18:00"]], ...}
  openingHours Json    @default("{}") @map("opening_hours")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rooms          Room[]
  equipment      Equipment[]
  userAccess     UserSiteAccess[]
  professionals  ProfessionalSite[]
  availabilities ProfessionalAvailability[]
  channels       Channel[]
  conversations  Conversation[]
  appointments   Appointment[]
  bookings       ResourceBooking[]
  events         PatientEvent[]
  pqrsf          Pqrsf[]
  leads          Lead[]
  waitlist       WaitlistEntry[]
  surgeries      Surgery[]
  invoices       Invoice[]

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  opticalOrders  OpticalOrder[]

  @@map("sites")
}

model Room {
  id       String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId   String   @map("site_id") @db.Uuid
  code     String
  name     String
  kind     RoomKind @default(CONSULTORIO)
  isActive Boolean  @default(true) @map("is_active")
  metadata Json     @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  site     Site              @relation(fields: [siteId], references: [id])
  bookings ResourceBooking[]

  @@unique([siteId, code])
  @@index([siteId, kind, isActive])
  @@map("rooms")
}

model Equipment {
  id           String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId       String            @map("site_id") @db.Uuid
  code         String
  name         String
  modality     EquipmentModality
  brand        String?
  model        String?
  serialNumber String?           @map("serial_number")
  isActive     Boolean           @default(true) @map("is_active")

  /// Gancho de metrologia (Res. 3100). Solo fechas, sin modulo de mantenimiento.
  lastServiceAt DateTime? @map("last_service_at") @db.Date
  nextServiceAt DateTime? @map("next_service_at") @db.Date

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  site     Site              @relation(fields: [siteId], references: [id])
  bookings ResourceBooking[]
  results  ServiceResult[]

  @@unique([siteId, code])
  @@index([siteId, modality, isActive])
  @@map("equipment")
}

// ═══════════════════════════════════════════════════════════════════
// CATALOGO
// ═══════════════════════════════════════════════════════════════════

model Service {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code         String       @unique
  /// CUPS. Gancho DIAN/RIPS.
  cupsCode     String?      @map("cups_code")
  name         String
  /// Enlaza con la pagina del sitio publico (visioncolombia/tools/build.py).
  slug         String       @unique
  businessLine BusinessLine @map("business_line")

  durationMin Int @map("duration_min")
  /// Limpieza del recurso despues. Se suma a la reserva, no a la cita.
  bufferMin   Int @default(0) @map("buffer_min")

  requiresProfessional Boolean            @default(true) @map("requires_professional")
  requiresRoom         Boolean            @default(true) @map("requires_room")
  requiredRoomKind     RoomKind?          @map("required_room_kind")
  requiredModality     EquipmentModality? @map("required_modality")

  requiresReferral      Boolean @default(false) @map("requires_referral")
  requiresAuthorization Boolean @default(false) @map("requires_authorization")
  requiresFasting       Boolean @default(false) @map("requires_fasting")
  /// Si dilata, el recordatorio avisa que no conduzca de regreso.
  requiresDilation      Boolean @default(false) @map("requires_dilation")
  requiresCompanion     Boolean @default(false) @map("requires_companion")
  /// Texto que sale por WhatsApp con el recordatorio.
  preparationNotes      String? @map("preparation_notes")

  isBilateral         Boolean @default(true) @map("is_bilateral")
  producesResultFile  Boolean @default(false) @map("produces_result_file")
  isSchedulableOnline Boolean @default(true) @map("is_schedulable_online")
  isActive            Boolean @default(true) @map("is_active")

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  prices        ServicePrice[]
  professionals ServiceProfessional[]
  appointments  Appointment[]
  leads         Lead[]
  waitlist      WaitlistEntry[]
  orders        ServiceOrder[]
  pqrsf         Pqrsf[]

  invoiceItems InvoiceItem[]

  @@index([businessLine, isActive])
  @@map("services")
}

// ═══════════════════════════════════════════════════════════════════
// USUARIOS Y AUDITORIA
// ═══════════════════════════════════════════════════════════════════

model User {
  id           String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  phone        String?
  role         UserRole   @default(RECEPCION)
  status       UserStatus @default(INVITED)

  /// Permisos finos adicionales al rol (<recurso>.<accion>). Vacio = solo el rol.
  extraPermissions     String[] @default([]) @map("extra_permissions")
  /// Puede ver pacientes de cualquier sede (direccion medica, auditoria).
  crossSitePatientRead Boolean  @default(false) @map("cross_site_patient_read")

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  lastLoginIp String?   @map("last_login_ip")

  /// Cuando se cambio la contrasena por ultima vez.
  ///
  /// Revocar los refresh tokens no basta: el access token ya emitido sigue
  /// siendo valido hasta 15 minutos. Si la clave se cambia porque se filtro,
  /// esos 15 minutos son justo los que no se pueden regalar. La estrategia
  /// JWT compara el `iat` del token contra esta marca y rechaza los
  /// anteriores.
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  mfaEnabled        Boolean   @default(false) @map("mfa_enabled")
  mfaSecret         String?   @map("mfa_secret")

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  siteAccess          UserSiteAccess[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  professional        Professional?
  consents            DataConsent[]
  conversations       Conversation[]
  messages            Message[]
  createdAppointments Appointment[]            @relation("CreadorDeCita")
  patientEvents       PatientEvent[]
  leads               Lead[]
  aiPrompts           AiPrompt[]
  serviceOrders       ServiceOrder[]
  resultsUploaded     ServiceResult[]          @relation("SubidoPor")
  pqrsfAsignadas      Pqrsf[]                  @relation("PqrsfAsignada")
  pqrsfRadicadas      Pqrsf[]                  @relation("PqrsfRadicada")
  statusEvents        AppointmentStatusEvent[]
  bookings            ResourceBooking[]

  surgeriesCreated Surgery[] @relation("CirugiaCreada")

  invoicesCreated  Invoice[] @relation("FacturaCreada")
  paymentsReceived Payment[] @relation("PagoRecibido")
  glosasCreated    Glosa[]   @relation("GlosaCreada")

  stockMovements       StockMovement[] @relation("MovimientoStock")
  opticalOrdersCreated OpticalOrder[]  @relation("OrdenOpticaCreada")

  @@index([role, status])
  @@map("users")
}

/// A que sedes accede el usuario. Sin fila = no ve la agenda de esa sede.
model UserSiteAccess {
  userId    String   @map("user_id") @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
  @@map("user_site_access")
}

model RefreshToken {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  token      String   @unique
  userId     String   @map("user_id") @db.Uuid
  deviceInfo String?  @map("device_info")
  ipAddress  String?  @map("ip_address")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  isRevoked  Boolean  @default(false) @map("is_revoked")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Inmutable de verdad: la migracion le revoca UPDATE y DELETE al rol de la
/// aplicacion. Sin updatedAt ni deletedAt, a proposito.
model AuditLog {
  id         String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id") @db.Uuid

  /// Desnormalizado a proposito: permite responder "quien consulto a este
  /// paciente" en UNA consulta, que es justo lo que pide una auditoria.
  personId String? @map("person_id") @db.Uuid
  siteId   String? @map("site_id") @db.Uuid

  /// En READ/EXPORT se guarda el filtro y el numero de registros devueltos.
  oldValues Json?   @map("old_values")
  newValues Json?   @map("new_values")
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  requestId String? @map("request_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User?   @relation(fields: [userId], references: [id])
  /// La persona nunca se borra fisicamente —el trigger de consentimientos lo
  /// impide—, asi que la clave foranea no puede dejar huerfano un registro.
  person Person? @relation("AuditoriaSobre", fields: [personId], references: [id])

  @@index([personId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════
// IDENTIDAD — global, NUNCA lleva siteId
//
// Vision Colombia es UNA IPS con tres sedes, no tres inquilinos. El
// paciente se atiende en las tres y debe ser el mismo registro. Poner
// siteId aqui "para filtrar mas rapido" es la decision que parece
// inocente y termina en tres fichas y tres historias de la misma
// persona. Lo que contiene el acceso no es un filtro: es que cada
// lectura de ficha queda en audit_logs.
// ═══════════════════════════════════════════════════════════════════

/// Persona unica. Se crea en el PRIMER contacto —incluido un WhatsApp de
/// alguien que solo pregunta—, mucho antes de ser paciente. `isPatient`
/// es una bandera, no otra tabla: asi el timeline y las conversaciones
/// nunca hay que re-parentarlos cuando la persona se convierte.
model Person {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  // RIPS y DIAN exigen los cuatro componentes del nombre por separado.
  // Partirlos despues, sobre miles de registros, es trabajo manual.
  docType       DocumentType?
  docNumber     String?       @map("doc_number")
  firstName     String        @map("first_name")
  secondName    String?       @map("second_name")
  firstSurname  String?       @map("first_surname")
  secondSurname String?       @map("second_surname")
  /// Desnormalizado para la busqueda trigram. Lo mantiene la aplicacion.
  displayName   String        @map("display_name")

  birthDate DateTime? @map("birth_date") @db.Date
  sex       Sex?
  /// E.164 (+57...). La normalizacion decide si un WhatsApp entrante
  /// engancha con una persona existente o crea un duplicado.
  phone     String?
  phoneAlt  String?   @map("phone_alt")
  email     String?

  // Geografia DIVIPOLA: obligatoria para RIPS y factura electronica.
  countryCode      String  @default("170") @map("country_code") @db.VarChar(3)
  departmentCode   String? @map("department_code") @db.VarChar(2)
  municipalityCode String? @map("municipality_code") @db.VarChar(5)
  zone             Zone?
  addressLine      String? @map("address_line")

  isPatient    Boolean   @default(false) @map("is_patient")
  patientSince DateTime? @map("patient_since") @db.Timestamptz(3)
  /// Numero de historia. Unico solo entre pacientes (indice parcial en SQL).
  mrn          String?

  occupation            String?
  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")
  emergencyContactRel   String? @map("emergency_contact_rel")

  /// Deduplicacion. Van a duplicar personas, garantizado: dos telefonos, un
  /// apellido mal escrito. Fusionar apuntando —y no borrando— es lo que
  /// permite que la ficha vieja siga resolviendo.
  mergedIntoId String?  @map("merged_into_id") @db.Uuid
  mergedInto   Person?  @relation("PersonMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Person[] @relation("PersonMerge")

  notes     String?
  tags      String[]  @default([])
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  coverages       Coverage[]
  consents        DataConsent[]
  conversations   Conversation[]
  appointments    Appointment[]
  events          PatientEvent[]
  leads           Lead[]
  waitlistEntries WaitlistEntry[]
  auditoria       AuditLog[]      @relation("AuditoriaSobre")
  serviceOrders   ServiceOrder[]
  pqrsf           Pqrsf[]

  surgeries Surgery[]

  invoices Invoice[]

  prescriptions Prescription[]
  opticalOrders OpticalOrder[]

  @@unique([docType, docNumber])
  @@index([displayName])
  @@index([phone])
  @@index([isPatient, createdAt])
  @@index([mergedIntoId])
  @@map("persons")
}

/// Asegurador o pagador. "Particular" tambien es un Payer, sembrado.
model Payer {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type                  PayerType
  /// Codigo de la entidad segun MinSalud.
  code                  String    @unique
  name                  String
  nit                   String?
  /// Digito de verificacion. Lo pide la DIAN y calcularlo despues es un lio.
  dv                    String?   @db.VarChar(1)
  isActive              Boolean   @default(true) @map("is_active")
  requiresAuthorization Boolean   @default(false) @map("requires_authorization")
  contactEmail          String?   @map("contact_email")
  metadata              Json      @default("{}")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  coverages    Coverage[]
  prices       ServicePrice[]
  appointments Appointment[]
  invoices     Invoice[]

  @@index([type, isActive])
  @@map("payers")
}

/// Afiliacion de una persona a un pagador. Puede tener varias a la vez
/// (EPS + prepagada + poliza); `isPrimary` decide cual se ofrece al agendar.
model Coverage {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  personId      String    @map("person_id") @db.Uuid
  payerId       String    @map("payer_id") @db.Uuid
  regime        Regime    @default(PARTICULAR)
  planName      String?   @map("plan_name")
  policyNumber  String?   @map("policy_number")
  affiliateType String?   @map("affiliate_type")
  isPrimary     Boolean   @default(false) @map("is_primary")
  validFrom     DateTime? @map("valid_from") @db.Date
  validTo       DateTime? @map("valid_to") @db.Date
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  person       Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  payer        Payer         @relation(fields: [payerId], references: [id])
  appointments Appointment[]

  @@index([personId, isPrimary])
  @@index([payerId])
  @@map("coverages")
}

/// Ley 1581 y Decreto 1377. Append-only por trigger: revocar es escribir
/// revokedAt, nunca borrar la fila. Se guarda el texto exacto de la version
/// aceptada, porque un booleano no prueba nada ante la SIC.
model DataConsent {
  id            String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  personId      String         @map("person_id") @db.Uuid
  purpose       ConsentPurpose
  granted       Boolean
  policyVersion String         @map("policy_version")
  channel       String
  evidenceUrl   String?        @map("evidence_url")
  evidenceText  String?        @map("evidence_text")
  ipAddress     String?        @map("ip_address")
  capturedById  String?        @map("captured_by_id") @db.Uuid
  grantedAt     DateTime       @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(3)

  person     Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  capturedBy User?  @relation(fields: [capturedById], references: [id])

  @@index([personId, purpose, grantedAt])
  @@map("data_consents")
}

// ═══════════════════════════════════════════════════════════════════
// PROFESIONALES
// ═══════════════════════════════════════════════════════════════════

/// Separado de User a proposito: hay profesionales que nunca entran al
/// sistema, y usuarios (recepcion) que no atienden a nadie. Meterlos en una
/// sola tabla es de los errores caros de deshacer.
model Professional {
  id            String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId        String?          @unique @map("user_id") @db.Uuid
  docType       DocumentType     @default(CC) @map("doc_type")
  docNumber     String           @map("doc_number")
  firstName     String           @map("first_name")
  lastName      String           @map("last_name")
  displayName   String           @map("display_name")
  type          ProfessionalType
  /// Registro medico / ReTHUS. RIPS lo exige en cada atencion.
  licenseNumber String?          @map("license_number")
  specialties   String[]         @default([])
  /// Color en el calendario de la agenda.
  color         String?
  isActive      Boolean          @default(true) @map("is_active")
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User?                      @relation(fields: [userId], references: [id])
  sites          ProfessionalSite[]
  availabilities ProfessionalAvailability[]
  services       ServiceProfessional[]
  orderedOrders  ServiceOrder[]             @relation("OrdenadaPor")
  results        ServiceResult[]            @relation("RealizadoPor")
  bookings       ResourceBooking[]

  surgeriesAsSurgeon          Surgery[]      @relation("Cirujano")
  surgeriesAsAnesthesiologist Surgery[]      @relation("Anestesiologo")
  prescriptions               Prescription[]

  @@unique([docType, docNumber])
  @@index([isActive, type])
  @@map("professionals")
}

model ProfessionalSite {
  professionalId String @map("professional_id") @db.Uuid
  siteId         String @map("site_id") @db.Uuid

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([professionalId, siteId])
  @@map("professional_sites")
}

/// Disponibilidad recurrente semanal, en minutos desde medianoche LOCAL de
/// la sede. Las ausencias NO van aqui: en E3 son ResourceBooking sin cita,
/// que el mismo EXCLUDE ya protege sin codigo extra.
model ProfessionalAvailability {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  professionalId String    @map("professional_id") @db.Uuid
  siteId         String    @map("site_id") @db.Uuid
  /// 0 = domingo ... 6 = sabado.
  weekday        Int       @db.SmallInt
  /// 480 = 08:00.
  startMinute    Int       @map("start_minute")
  endMinute      Int       @map("end_minute")
  /// Vacio = atiende cualquier servicio que tenga habilitado.
  serviceIds     String[]  @default([]) @map("service_ids") @db.Uuid
  validFrom      DateTime? @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id])

  @@index([professionalId, weekday])
  @@index([siteId, weekday])
  @@map("professional_availabilities")
}

/// Que profesional puede prestar que servicio. Sin fila, no puede.
model ServiceProfessional {
  serviceId      String @map("service_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  /// La Dra. X hace catarata en 40 y no en 60. Sin este campo, la agenda
  /// miente para todo el mundo salvo para el caso promedio.
  durationMin    Int?   @map("duration_min")

  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([serviceId, professionalId])
  @@map("service_professionals")
}

/// Tarifa por asegurador. payerId null = tarifa base/particular;
/// siteId null = tarifa de red, con fila = excepcion de esa sede.
model ServicePrice {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  serviceId  String    @map("service_id") @db.Uuid
  payerId    String?   @map("payer_id") @db.Uuid
  siteId     String?   @map("site_id") @db.Uuid
  price      Decimal   @db.Decimal(14, 2)
  /// Copago o cuota moderadora que asume el paciente.
  copay      Decimal?  @db.Decimal(14, 2)
  currency   String    @default("COP") @db.VarChar(3)
  /// Manual tarifario contratado: ISS2001, SOAT2024, PROPIA.
  tariffBook String?   @map("tariff_book")
  validFrom  DateTime  @map("valid_from") @db.Date
  validTo    DateTime? @map("valid_to") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  payer   Payer?  @relation(fields: [payerId], references: [id])

  @@index([serviceId, payerId, validFrom])
  @@map("service_prices")
}

/// Festivos colombianos. Se siembran, no se recalculan en cada consulta de
/// disponibilidad: la ley Emiliani mueve varios al lunes siguiente y esa
/// regla no se reimplementa en tres sitios distintos.
model Holiday {
  date       DateTime @id @db.Date
  name       String
  isNational Boolean  @default(true) @map("is_national")

  @@map("holidays")
}

// ═══════════════════════════════════════════════════════════════════
// CANAL, CONVERSACION Y MENSAJE
// ═══════════════════════════════════════════════════════════════════

/// Un canal es una linea por la que entra o sale un mensaje. Hoy solo hay
/// Baileys; el enum existe para que anadir Cloud API manana sea una fila y
/// un adaptador, no una migracion de todo lo que cuelga de aqui.
model Channel {
  id          String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  provider    ChannelProvider
  name        String
  phoneNumber String?         @map("phone_number")
  /// null = linea central de la clinica. Con fila, atiende una sede.
  siteId      String?         @map("site_id") @db.Uuid
  status      ChannelStatus   @default(DESCONECTADO)

  /// Credenciales de sesion de Baileys, CIFRADAS con AES-256-GCM.
  ///
  /// No van en disco. `useMultiFileAuthState` las escribe en texto plano en
  /// una carpeta: quien lea ese directorio se hace pasar por la clinica en
  /// WhatsApp, y ademas se pierden al recrear el contenedor y toca volver a
  /// escanear el QR. Aqui viajan cifradas con WHATSAPP_AUTH_ENCRYPTION_KEY,
  /// que vive en el entorno y nunca en la base.
  /// Formato `iv.tag.ciphertext` en base64, en una sola columna. Tres
  /// columnas separadas solo multiplicaban las formas de escribir una y
  /// olvidar otra, y ninguna se consulta por su cuenta.
  authState String? @map("auth_state")

  /// El QR solo existe mientras la sesion espera escaneo, y caduca.
  qrCode      String?   @map("qr_code")
  qrExpiresAt DateTime? @map("qr_expires_at") @db.Timestamptz(3)

  isDefault       Boolean   @default(false) @map("is_default")
  lastConnectedAt DateTime? @map("last_connected_at") @db.Timestamptz(3)
  /// Motivo de la ultima caida. `loggedOut` es el que hay que mirar: es el
  /// sintoma de que WhatsApp cerro la sesion, posiblemente por baneo.
  lastError       String?   @map("last_error")

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  site          Site?          @relation(fields: [siteId], references: [id])
  conversations Conversation[]

  @@index([provider, status])
  @@map("channels")
}

/// Existe ANTES de que haya paciente: el primer mensaje de un numero
/// desconocido ya crea Person y Conversation. `personId` se llena en cuanto
/// el bot o recepcion identifica a quien escribe, sin re-parentar nada.
model Conversation {
  id           String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  channelId    String  @map("channel_id") @db.Uuid
  /// remoteJid de WhatsApp. Con channelId forma la clave natural.
  externalId   String  @map("external_id")
  personId     String? @map("person_id") @db.Uuid
  assignedToId String? @map("assigned_to_id") @db.Uuid
  /// Sede que atiende. Puede cambiar; no aisla al paciente.
  siteId       String? @map("site_id") @db.Uuid

  contactName   String?            @map("contact_name")
  phoneNumber   String?            @map("phone_number")
  status        ConversationStatus @default(ABIERTA)
  /// true = el asistente responde. Recepcion lo apaga al tomar el caso, y
  /// el handoff lo apaga solo cuando detecta que hace falta un humano.
  aiEnabled     Boolean            @default(true) @map("ai_enabled")
  aiSummary     String?            @map("ai_summary")
  aiPausedUntil DateTime?          @map("ai_paused_until") @db.Timestamptz(3)

  unreadCount     Int       @default(0) @map("unread_count")
  lastMessageAt   DateTime? @map("last_message_at") @db.Timestamptz(3)
  lastMessageText String?   @map("last_message_text")

  tags      String[]  @default([])
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  person       Person?       @relation(fields: [personId], references: [id])
  assignedTo   User?         @relation(fields: [assignedToId], references: [id])
  site         Site?         @relation(fields: [siteId], references: [id])
  messages     Message[]
  appointments Appointment[]
  leads        Lead[]

  @@unique([channelId, externalId])
  @@index([status, lastMessageAt(sort: Desc)])
  @@index([personId])
  @@index([assignedToId, status])
  @@index([siteId, status])
  @@map("conversations")
}

model Message {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  /// Id del proveedor. Unico: es lo que impide duplicar un mensaje cuando
  /// Baileys reemite el mismo evento tras reconectar.
  externalId     String?          @unique @map("external_id")
  direction      MessageDirection
  author         MessageAuthor    @default(PACIENTE)
  type           MessageType      @default(TEXT)
  status         MessageStatus    @default(PENDIENTE)

  body      String?
  mediaUrl  String? @map("media_url")
  mediaMime String? @map("media_mime")
  mediaSize Int?    @map("media_size")
  fileName  String? @map("file_name")

  /// Nota interna: se ve en el panel y NO se envia al paciente. Sin esto,
  /// el equipo se coordina por fuera y el contexto se pierde.
  isInternal Boolean @default(false) @map("is_internal")

  quotedExternalId String? @map("quoted_external_id")
  sentById         String? @map("sent_by_id") @db.Uuid
  /// Traza de la ejecucion del asistente cuando author = IA.
  aiRunId          String? @map("ai_run_id")

  /// Clave de idempotencia del envio: reintentar no debe duplicar el mensaje
  /// que el paciente recibe.
  idempotencyKey String? @unique @map("idempotency_key")

  sentAt      DateTime? @map("sent_at") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(3)
  error       String?

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentBy       User?        @relation(fields: [sentById], references: [id])

  @@index([conversationId, createdAt])
  @@index([status, createdAt])
  @@map("messages")
}

// ═══════════════════════════════════════════════════════════════════
// AGENDA
// ═══════════════════════════════════════════════════════════════════

model Appointment {
  id         String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Codigo corto para decirselo al paciente por WhatsApp: VC-4F7K2.
  publicCode String @unique @map("public_code")

  siteId    String            @map("site_id") @db.Uuid
  personId  String            @map("person_id") @db.Uuid
  serviceId String            @map("service_id") @db.Uuid
  status    AppointmentStatus @default(PROGRAMADA)

  startsAt   DateTime   @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime   @map("ends_at") @db.Timestamptz(3)
  laterality Laterality @default(NA)

  // Ganchos de facturacion. Hoy informativos; el dia que entre la emision
  // electronica ya estaran llenos en vez de haber que retrollenarlos.
  payerId             String?  @map("payer_id") @db.Uuid
  coverageId          String?  @map("coverage_id") @db.Uuid
  authorizationNumber String?  @map("authorization_number")
  referralFileUrl     String?  @map("referral_file_url")
  quotedPrice         Decimal? @map("quoted_price") @db.Decimal(14, 2)

  createdVia     ChannelProvider @default(PRESENCIAL) @map("created_via")
  createdById    String?         @map("created_by_id") @db.Uuid
  conversationId String?         @map("conversation_id") @db.Uuid
  serviceOrderId String?         @map("service_order_id") @db.Uuid

  // Marcas desnormalizadas del recorrido. La verdad esta en
  // AppointmentStatusEvent; esto existe para que el tablero del dia sea una
  // consulta y no un agregado sobre el historial.
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  arrivedAt   DateTime? @map("arrived_at") @db.Timestamptz(3)
  attendedAt  DateTime? @map("attended_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  cancelledAt       DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  cancelActor       CancelActor? @map("cancel_actor")
  cancelReason      String?      @map("cancel_reason")
  rescheduledFromId String?      @unique @map("rescheduled_from_id") @db.Uuid

  notes     String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  site         Site          @relation(fields: [siteId], references: [id])
  person       Person        @relation(fields: [personId], references: [id])
  service      Service       @relation(fields: [serviceId], references: [id])
  payer        Payer?        @relation(fields: [payerId], references: [id])
  coverage     Coverage?     @relation(fields: [coverageId], references: [id])
  createdBy    User?         @relation("CreadorDeCita", fields: [createdById], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  serviceOrder ServiceOrder? @relation("OrdenAgendada", fields: [serviceOrderId], references: [id])

  rescheduledFrom Appointment? @relation("Reagenda", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Appointment? @relation("Reagenda")

  bookings      ResourceBooking[]
  statusEvents  AppointmentStatusEvent[]
  notifications AppointmentNotification[]
  waitlistFills WaitlistEntry[]           @relation("CupoOcupado")
  ordersCreated ServiceOrder[]            @relation("OrigenDeOrden")
  results       ServiceResult[]

  surgery       Surgery?
  invoiceItems  InvoiceItem[]
  prescriptions Prescription[]

  @@index([siteId, startsAt])
  @@index([siteId, status, startsAt])
  @@index([personId, startsAt(sort: Desc)])
  @@index([status, startsAt])
  @@map("appointments")
}

/// EL CORAZON DE LA AGENDA.
///
/// Una fila por recurso ocupado: una cita de OCT con medico, sala y equipo
/// genera TRES filas con el mismo rango. Un bloqueo —vacaciones, almuerzo,
/// mantenimiento— es una fila con appointmentId nulo, y el mismo constraint
/// lo protege sin una linea de codigo extra.
///
/// La no-superposicion NO se valida en la aplicacion: la impone PostgreSQL
/// con EXCLUDE USING gist. El conflicto aqui no es "dos personas editan la
/// misma cita" —donde serviria un numero de version— sino "dos personas
/// crean citas distintas que se solapan", y ahi no hay fila comun sobre la
/// que competir. Simularlo exigiria un candado a mano en TODOS los caminos
/// de escritura; uno que se olvide y hay doble reserva.
model ResourceBooking {
  id            String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  appointmentId String? @map("appointment_id") @db.Uuid
  siteId        String  @map("site_id") @db.Uuid

  // Exactamente uno de los tres. Lo impone un CHECK en la migracion.
  professionalId String?      @map("professional_id") @db.Uuid
  roomId         String?      @map("room_id") @db.Uuid
  equipmentId    String?      @map("equipment_id") @db.Uuid
  kind           ResourceKind

  /// Incluye el buffer del servicio: la reserva puede ser mas ancha que la
  /// cita, porque el consultorio sigue ocupado mientras se limpia.
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  /// El EXCLUDE es PARCIAL sobre active. Cancelar es poner false en la misma
  /// transaccion que el cambio de estado: libera el cupo sin perder la
  /// historia de que estuvo reservado.
  active      Boolean @default(true)
  blockReason String? @map("block_reason")

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment  Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  site         Site          @relation(fields: [siteId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
  room         Room?         @relation(fields: [roomId], references: [id])
  equipment    Equipment?    @relation(fields: [equipmentId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id])

  @@index([appointmentId])
  @@index([professionalId, startsAt])
  @@index([roomId, startsAt])
  @@index([equipmentId, startsAt])
  @@index([siteId, startsAt])
  @@map("resource_bookings")
}

/// Historial de transicion, append-only. Es la fuente de verdad del
/// recorrido y de los indicadores: oportunidad de cita, tiempo de espera,
/// tasa de no-show. Sin esta tabla habria que instrumentar retroactivamente,
/// que es imposible.
model AppointmentStatusEvent {
  id            String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  appointmentId String             @map("appointment_id") @db.Uuid
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus  @map("to_status")
  reason        String?
  byUserId      String?            @map("by_user_id") @db.Uuid
  /// Para transiciones automaticas: "job:barrido_no_show", "wa:confirmacion".
  bySystem      String?            @map("by_system")
  occurredAt    DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(3)
  metadata      Json               @default("{}")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  byUser      User?       @relation(fields: [byUserId], references: [id])

  @@index([appointmentId, occurredAt])
  @@index([toStatus, occurredAt])
  @@map("appointment_status_events")
}

// ═══════════════════════════════════════════════════════════════════
// LINEA DE TIEMPO Y COMERCIAL
// ═══════════════════════════════════════════════════════════════════

/// Log de eventos de dominio, append-only, escrito EN LA MISMA TRANSACCION
/// que el cambio que lo origina.
///
/// NO es event sourcing: la verdad sigue en las tablas normalizadas. Esta
/// tabla es una PROYECCION desechable y reconstruible.
///
/// Se gana que el Paciente 360 sea una consulta indexada en vez de un UNION
/// de quince tablas que habria que reescribir cada vez que entra un modulo
/// nuevo: facturacion, optica o cirugia solo insertan una fila aqui.
///
/// Se pierde que es dato duplicado y puede derivar. Mitigacion, en este
/// orden: una sola funcion escribe aqui (`TimelineService.emitir`); la tabla
/// se reconstruye entera con `scripts/reconstruir-timeline.ts`; y nunca se
/// lee para tomar una decision — es una pantalla.
model PatientEvent {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  personId    String           @map("person_id") @db.Uuid
  type        PatientEventType
  occurredAt  DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(3)
  siteId      String?          @map("site_id") @db.Uuid
  actorUserId String?          @map("actor_user_id") @db.Uuid

  /// Texto ya compuesto para la pantalla: "Agendó OCT con Dra. Ruiz".
  title String

  /// Puntero al registro real. Sin clave foranea a proposito y
  /// deliberadamente debil: el timeline sobrevive al borrado del origen.
  refType String? @map("ref_type")
  refId   String? @map("ref_id") @db.Uuid

  payload Json @default("{}")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  site   Site?  @relation(fields: [siteId], references: [id])
  actor  User?  @relation(fields: [actorUserId], references: [id])

  @@index([personId, occurredAt(sort: Desc)])
  @@index([type, occurredAt])
  @@index([refType, refId])
  @@map("patient_events")
}

/// Oportunidad comercial. SIEMPRE cuelga de una Person, que puede no ser
/// paciente todavia: es lo que permite ver "escribio por WhatsApp -> pidio
/// informacion -> agendo" sin re-parentar nada por el camino.
model Lead {
  id                String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  personId          String          @map("person_id") @db.Uuid
  conversationId    String?         @map("conversation_id") @db.Uuid
  siteId            String?         @map("site_id") @db.Uuid
  status            LeadStatus      @default(NUEVO)
  source            ChannelProvider @default(BAILEYS)
  interestServiceId String?         @map("interest_service_id") @db.Uuid
  interestText      String?         @map("interest_text")
  quotedAmount      Decimal?        @map("quoted_amount") @db.Decimal(14, 2)
  quotedAt          DateTime?       @map("quoted_at") @db.Timestamptz(3)
  assignedToId      String?         @map("assigned_to_id") @db.Uuid
  lostReason        String?         @map("lost_reason")
  convertedAt       DateTime?       @map("converted_at") @db.Timestamptz(3)
  metadata          Json            @default("{}")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  person          Person        @relation(fields: [personId], references: [id])
  conversation    Conversation? @relation(fields: [conversationId], references: [id])
  interestService Service?      @relation(fields: [interestServiceId], references: [id])
  assignedTo      User?         @relation(fields: [assignedToId], references: [id])
  site            Site?         @relation(fields: [siteId], references: [id])

  @@index([status, createdAt])
  @@index([personId])
  @@map("leads")
}

// ═══════════════════════════════════════════════════════════════════
// RECORDATORIOS
// ═══════════════════════════════════════════════════════════════════

/// Un recordatorio programado por cita y tipo.
///
/// La unicidad de (cita, tipo) es lo que da entrega exactamente-una-vez sin
/// necesidad de Redis ni de una cola: el planificador puede correr dos veces
/// o solaparse consigo mismo y el paciente recibe un solo mensaje.
model AppointmentNotification {
  id            String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  appointmentId String              @map("appointment_id") @db.Uuid
  kind          NotificationKind
  channel       ChannelProvider     @default(BAILEYS)
  scheduledFor  DateTime            @map("scheduled_for") @db.Timestamptz(3)
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(3)
  outcome       NotificationOutcome @default(PENDIENTE)
  respondedAt   DateTime?           @map("responded_at") @db.Timestamptz(3)
  messageId     String?             @map("message_id") @db.Uuid
  error         String?
  attempts      Int                 @default(0)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, kind])
  @@index([outcome, scheduledFor])
  @@map("appointment_notifications")
}

/// Lista de espera: a quien ofrecerle el cupo que acaba de liberarse.
model WaitlistEntry {
  id                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteId              String    @map("site_id") @db.Uuid
  personId            String    @map("person_id") @db.Uuid
  serviceId           String    @map("service_id") @db.Uuid
  professionalId      String?   @map("professional_id") @db.Uuid
  preferredFrom       DateTime? @map("preferred_from") @db.Timestamptz(3)
  preferredTo         DateTime? @map("preferred_to") @db.Timestamptz(3)
  /// 0 normal, 100 prioritario (posquirurgico, urgencia relativa).
  priority            Int       @default(0)
  isActive            Boolean   @default(true) @map("is_active")
  notifiedAt          DateTime? @map("notified_at") @db.Timestamptz(3)
  filledAppointmentId String?   @map("filled_appointment_id") @db.Uuid
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  site    Site         @relation(fields: [siteId], references: [id])
  person  Person       @relation(fields: [personId], references: [id])
  service Service      @relation(fields: [serviceId], references: [id])
  filled  Appointment? @relation("CupoOcupado", fields: [filledAppointmentId], references: [id])

  @@index([siteId, serviceId, isActive, priority(sort: Desc)])
  @@map("waitlist_entries")
}

// ═══════════════════════════════════════════════════════════════════
// ASISTENTE
// ═══════════════════════════════════════════════════════════════════

/// El prompt del asistente vive en la base y se versiona.
///
/// No en un archivo del codigo: ajustarlo es trabajo de producto, no de
/// despliegue, y sobre todo hace falta poder VOLVER ATRAS en un minuto
/// cuando una version empieza a decir cosas raras a los pacientes. Un
/// `git revert` mas un despliegue no es un minuto.
model AiPrompt {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Que hace este prompt: "atencion", "clasificacion".
  slug        String
  version     Int
  /// Comportamiento: como habla, que no hace, cuando escala.
  content     String
  notes       String?
  /// Solo una version activa por slug. Lo impone un indice parcial.
  isActive    Boolean  @default(false) @map("is_active")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy User? @relation(fields: [createdById], references: [id])

  @@unique([slug, version])
  @@index([slug, isActive])
  @@map("ai_prompts")
}

/// Una ejecucion del asistente. Es la trazabilidad: que se le pregunto, que
/// modelo respondio, que herramientas uso, cuanto costo y si se envio o se
/// escalo. Sin esto, "el bot dijo algo raro" no se puede investigar.
model AiRun {
  id             String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid
  personId       String? @map("person_id") @db.Uuid
  promptId       String? @map("prompt_id") @db.Uuid

  provider String
  model    String
  entrada  String
  salida   String?
  /// Herramientas invocadas, en orden, con sus argumentos.
  tools    Json    @default("[]")

  /// Por que no se envio: sintoma detectado, consejo clinico bloqueado,
  /// presupuesto agotado, error del proveedor.
  escaladoMotivo String? @map("escalado_motivo")
  enviado        Boolean @default(false)

  tokensEntrada Int?     @map("tokens_entrada")
  tokensSalida  Int?     @map("tokens_salida")
  costoUsd      Decimal? @map("costo_usd") @db.Decimal(10, 6)
  duracionMs    Int?     @map("duracion_ms")
  error         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([conversationId, createdAt])
  @@index([createdAt])
  @@map("ai_runs")
}

// ═══════════════════════════════════════════════════════════════════
// ORDENES Y RESULTADOS
//
// ⚠ Esto NO es historia clinica, y la linea es fina a proposito:
//
//   - Una ORDEN dice que a alguien le mandaron un examen. Es
//     administrativo: sirve para agendarlo y para saber quien se quedo a
//     mitad de camino.
//   - Un RESULTADO se guarda como ARCHIVO con sus metadatos. Guardar el
//     PDF que produjo el equipo no convierte a la clinica en custodio de
//     una historia clinica.
//
//   `reportText` es la excepcion y hay que tratarla como tal: un informe
//   transcrito por un profesional de la clinica SI es historia clinica
//   bajo la Res. 1995/1999 —conservacion de 15 anos, prohibicion de
//   borrado, registro de accesos—. El esquema lo soporta (sin DELETE,
//   con sha256, con auditoria de lectura), pero si el equipo no va a
//   operar bajo esas reglas, ese campo debe quedarse vacio.
// ═══════════════════════════════════════════════════════════════════

/// "Al paciente le mandaron un OCT". Vive aunque nadie la agende, y ahi
/// esta su valor: la lista de ordenes sin agendar es la de pacientes que
/// se quedaron a medio camino. Sin ella, un examen ordenado y nunca hecho
/// no aparece en ningun sitio.
model ServiceOrder {
  id         String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  personId   String             @map("person_id") @db.Uuid
  serviceId  String             @map("service_id") @db.Uuid
  status     ServiceOrderStatus @default(PENDIENTE)
  laterality Laterality         @default(NA)

  /// La consulta donde se genero la orden.
  originAppointmentId     String? @map("origin_appointment_id") @db.Uuid
  orderedByProfessionalId String? @map("ordered_by_professional_id") @db.Uuid

  /// Orden de otra IPS: solo el archivo escaneado.
  externalOrderUrl    String?   @map("external_order_url")
  authorizationNumber String?   @map("authorization_number")
  authorizedAt        DateTime? @map("authorized_at") @db.Timestamptz(3)
  /// Vencida, la EPS suele no autorizarla. Por eso se vigila.
  dueDate             DateTime? @map("due_date") @db.Date

  indications String?
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  person            Person        @relation(fields: [personId], references: [id])
  service           Service       @relation(fields: [serviceId], references: [id])
  originAppointment Appointment?  @relation("OrigenDeOrden", fields: [originAppointmentId], references: [id])
  orderedBy         Professional? @relation("OrdenadaPor", fields: [orderedByProfessionalId], references: [id])
  createdBy         User?         @relation(fields: [createdById], references: [id])

  scheduledAppointments Appointment[]   @relation("OrdenAgendada")
  results               ServiceResult[]

  @@index([personId, status])
  @@index([status, dueDate])
  @@map("service_orders")
}

/// El resultado, como archivo con metadatos. Append-only: no se edita ni
/// se borra, se sube otra version.
model ServiceResult {
  id             String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  serviceOrderId String? @map("service_order_id") @db.Uuid
  appointmentId  String? @map("appointment_id") @db.Uuid

  fileUrl   String @map("file_url")
  fileName  String @map("file_name")
  mimeType  String @map("mime_type")
  sizeBytes Int    @map("size_bytes")

  /// Integridad del documento clinico. Barato ahora, imposible retroactivo:
  /// sin el no hay forma de demostrar que el informe que se descarga hoy es
  /// el mismo que se subio, y un resultado alterado es un problema clinico,
  /// no informatico.
  sha256 String @db.VarChar(64)

  performedAt   DateTime @map("performed_at") @db.Timestamptz(3)
  performedById String?  @map("performed_by_id") @db.Uuid
  equipmentId   String?  @map("equipment_id") @db.Uuid

  /// Preliminar o definitivo. Entregar un preliminar como definitivo es
  /// peor que no entregar nada.
  isFinal Boolean @default(false) @map("is_final")

  /// ⚠ Si se llena, esto ya es historia clinica. Ver la nota de arriba.
  reportText String? @map("report_text")

  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  performedBy  Professional? @relation("RealizadoPor", fields: [performedById], references: [id])
  equipment    Equipment?    @relation(fields: [equipmentId], references: [id])
  uploadedBy   User?         @relation("SubidoPor", fields: [uploadedById], references: [id])

  @@index([serviceOrderId])
  @@index([appointmentId])
  @@map("service_results")
}

// ═══════════════════════════════════════════════════════════════════
// PQRSF
// ═══════════════════════════════════════════════════════════════════

/// Peticion, queja, reclamo, sugerencia o felicitacion.
///
/// Cuelga de Person y no de una tabla suelta a proposito: una queja
/// desconectada del resto de la relacion con la clinica es una queja que
/// nadie relaciona con las tres citas canceladas que la provocaron.
model Pqrsf {
  id       String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Numero de radicado que se le da al paciente. Consecutivo por ano.
  radicado String      @unique
  tipo     PqrsfTipo
  estado   PqrsfEstado @default(RADICADA)

  personId  String? @map("person_id") @db.Uuid
  /// Puede radicar alguien que no es paciente: un acompanante, un familiar.
  nombre    String?
  contacto  String?
  siteId    String? @map("site_id") @db.Uuid
  serviceId String? @map("service_id") @db.Uuid

  asunto  String
  detalle String

  /// Plazo legal. Se calcula en dias HABILES descontando festivos: contar
  /// corridos da una fecha que la clinica cree cumplir y no cumple.
  dueDate      DateTime  @map("due_date") @db.Date
  assignedToId String?   @map("assigned_to_id") @db.Uuid
  respuesta    String?
  respondedAt  DateTime? @map("responded_at") @db.Timestamptz(3)
  closedAt     DateTime? @map("closed_at") @db.Timestamptz(3)

  /// 1 a 5, preguntado despues de cerrar.
  satisfaccion Int? @db.SmallInt

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  person     Person?  @relation(fields: [personId], references: [id])
  site       Site?    @relation(fields: [siteId], references: [id])
  service    Service? @relation(fields: [serviceId], references: [id])
  assignedTo User?    @relation("PqrsfAsignada", fields: [assignedToId], references: [id])
  createdBy  User?    @relation("PqrsfRadicada", fields: [createdById], references: [id])

  @@index([estado, dueDate])
  @@index([personId])
  @@map("pqrsf")
}

// ═══════════════════════════════════════════════════════════════════
// CIRUGIA
// ═══════════════════════════════════════════════════════════════════

enum SurgeryStatus {
  PROGRAMADA
  EN_PREPARACION
  EN_QUIROFANO
  OPERADA
  SUSPENDIDA
}

enum AnesthesiaType {
  TOPICA
  LOCAL
  PERIBULBAR
  SEDACION
  GENERAL
}

/// Programacion quirurgica.
///
/// Cuelga de una Appointment y no se reinventa la agenda: el quirofano, el
/// cirujano y el equipo se reservan con las mismas ResourceBooking, asi que la
/// misma restriccion EXCLUDE de PostgreSQL que impide dos citas solapadas
/// impide dos cirugias en el mismo quirofano. Cero codigo extra.
///
/// Lo que si es propio de aqui es lo que no se puede hacer mal: el
/// consentimiento, la lista de verificacion de la OMS y la LATERALIDAD.
/// Operar el ojo equivocado es el evento adverso centinela de la
/// oftalmologia, y es 100% prevenible con una pausa quirurgica que alguien
/// tenga que firmar.
model Surgery {
  id            String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Una cita, una cirugia.
  appointmentId String @unique @map("appointment_id") @db.Uuid
  personId      String @map("person_id") @db.Uuid
  siteId        String @map("site_id") @db.Uuid

  status SurgeryStatus @default(PROGRAMADA)

  /// NUNCA puede ser AO ni NA. Se valida en el servicio y se vuelve a
  /// confirmar en voz alta durante la pausa quirurgica.
  laterality Laterality

  surgeonId          String  @map("surgeon_id") @db.Uuid
  anesthesiologistId String? @map("anesthesiologist_id") @db.Uuid
  /// Instrumentador, circulante, ayudantes: nombres, no usuarios del sistema.
  teamNotes          String? @map("team_notes")

  anesthesia AnesthesiaType @default(TOPICA)

  /// Consentimiento informado QUIRURGICO, distinto del de datos personales.
  /// Sin el firmado no se entra a quirofano.
  consentSignedAt DateTime? @map("consent_signed_at") @db.Timestamptz(3)
  consentFileUrl  String?   @map("consent_file_url")

  // ── Lista de verificacion de la OMS, sus tres fases ────────────────
  // Cada fase guarda QUIEN la cerro y CUANDO, no solo que se hizo: una
  // lista sin responsable no es una lista, es un adorno.
  entryAt   DateTime? @map("entry_at") @db.Timestamptz(3)
  entryById String?   @map("entry_by_id") @db.Uuid
  entryData Json?     @map("entry_data")
  pauseAt   DateTime? @map("pause_at") @db.Timestamptz(3)
  pauseById String?   @map("pause_by_id") @db.Uuid
  pauseData Json?     @map("pause_data")
  exitAt    DateTime? @map("exit_at") @db.Timestamptz(3)
  exitById  String?   @map("exit_by_id") @db.Uuid
  exitData  Json?     @map("exit_data")

  startedAt     DateTime? @map("started_at") @db.Timestamptz(3)
  endedAt       DateTime? @map("ended_at") @db.Timestamptz(3)
  findings      String?
  complications String?
  suspendReason String?   @map("suspend_reason")

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointment      Appointment      @relation(fields: [appointmentId], references: [id])
  person           Person           @relation(fields: [personId], references: [id])
  site             Site             @relation(fields: [siteId], references: [id])
  surgeon          Professional     @relation("Cirujano", fields: [surgeonId], references: [id])
  anesthesiologist Professional?    @relation("Anestesiologo", fields: [anesthesiologistId], references: [id])
  createdBy        User?            @relation("CirugiaCreada", fields: [createdById], references: [id])
  implants         SurgeryImplant[]

  @@index([siteId, status])
  @@index([personId])
  @@map("surgeries")
}

/// Lente intraocular u otro implante, con su lote y su serie.
///
/// Es una tabla y no un campo en Surgery por una sola pregunta, la que se
/// hace el dia de un retiro del mercado: "que pacientes tienen un lente de
/// este lote". Con los datos metidos en un texto libre esa consulta no se
/// puede responder, y hay que llamar a todos.
model SurgeryImplant {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  surgeryId String @map("surgery_id") @db.Uuid

  kind   String
  brand  String?
  model  String?
  /// Poder dioptrico del lente. Decimal porque los pasos son de 0.5 D.
  power  Decimal? @db.Decimal(6, 2)
  lot    String?
  serial String?
  /// Registro sanitario INVIMA.
  invima String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  surgery Surgery @relation(fields: [surgeryId], references: [id], onDelete: Cascade)

  @@index([surgeryId])
  @@index([lot])
  @@index([serial])
  @@map("surgery_implants")
}

// ═══════════════════════════════════════════════════════════════════
// FACTURACION INTERNA Y CARTERA
// ═══════════════════════════════════════════════════════════════════

enum InvoiceStatus {
  BORRADOR
  EMITIDA
  PAGADA
  ANULADA
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_DEBITO
  TARJETA_CREDITO
  TRANSFERENCIA
  PSE
  BONO
  OTRO
}

enum GlosaStatus {
  RECIBIDA
  RESPONDIDA
  ACEPTADA
  LEVANTADA
}

/// Cuenta de cobro interna.
///
/// NO es la factura electronica de la DIAN. Esa la emite un proveedor
/// autorizado y sigue fuera de alcance por decision tomada al empezar. Esto
/// es lo que la clinica necesita antes: saber cuanto se le debe, quien lo
/// debe y desde hace cuanto.
///
/// El dia que entre la emision electronica, `dianCufe` y `dianStatus` se
/// llenan y el resto del modelo no cambia.
model Invoice {
  id     String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Consecutivo interno por ano: FV-2026-000123.
  number String        @unique
  status InvoiceStatus @default(BORRADOR)

  personId String  @map("person_id") @db.Uuid
  siteId   String  @map("site_id") @db.Uuid
  /// Nulo = particular: paga el paciente de su bolsillo.
  payerId  String? @map("payer_id") @db.Uuid

  /// Todo el dinero es Decimal(14,2). Un float en pesos redondea mal y el
  /// error solo aparece cuando la suma de las lineas no da el total.
  subtotal Decimal @default(0) @db.Decimal(14, 2)
  discount Decimal @default(0) @db.Decimal(14, 2)
  /// Lo que asume el paciente aunque haya asegurador: copago o cuota
  /// moderadora. Se guarda aparte porque se cobra en mostrador el mismo dia,
  /// mientras el resto se le radica a la EPS y se cobra en meses.
  copay    Decimal @default(0) @db.Decimal(14, 2)
  total    Decimal @default(0) @db.Decimal(14, 2)

  issuedAt   DateTime? @map("issued_at") @db.Timestamptz(3)
  /// Fecha limite de pago. Sin ella la cartera no se puede clasificar por
  /// edades, que es lo unico que hace accionable un saldo pendiente.
  dueDate    DateTime? @map("due_date") @db.Date
  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(3)
  voidReason String?   @map("void_reason")

  /// Radicacion ante el asegurador: sin numero y fecha, la EPS dice que
  /// nunca llego y no hay como probar lo contrario.
  filedAt     DateTime? @map("filed_at") @db.Timestamptz(3)
  filedNumber String?   @map("filed_number")

  // Ganchos DIAN, hoy vacios.
  dianCufe   String? @map("dian_cufe")
  dianStatus String? @map("dian_status")

  notes       String?
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  person    Person        @relation(fields: [personId], references: [id])
  site      Site          @relation(fields: [siteId], references: [id])
  payer     Payer?        @relation(fields: [payerId], references: [id])
  createdBy User?         @relation("FacturaCreada", fields: [createdById], references: [id])
  items     InvoiceItem[]
  payments  Payment[]
  glosas    Glosa[]

  @@index([status, dueDate])
  @@index([personId])
  @@index([payerId, status])
  @@index([siteId, issuedAt])
  @@map("invoices")
}

model InvoiceItem {
  id            String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  invoiceId     String  @map("invoice_id") @db.Uuid
  serviceId     String  @map("service_id") @db.Uuid
  /// De donde salio el cobro. Nulo si se factura algo sin cita.
  appointmentId String? @map("appointment_id") @db.Uuid

  /// Se copia del servicio al facturar, no se lee por relacion: el CUPS de
  /// hoy no puede cambiar el de una factura emitida el ano pasado.
  cupsCode    String? @map("cups_code")
  description String

  quantity  Int     @default(1)
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  discount  Decimal @default(0) @db.Decimal(14, 2)
  total     Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service     Service      @relation(fields: [serviceId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

/// Un pago recibido. NUNCA se borra ni se edita: si estuvo mal, se registra
/// otro en negativo con su motivo. Un pago que se puede editar es un pago que
/// no prueba nada.
model Payment {
  id        String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  invoiceId String        @map("invoice_id") @db.Uuid
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod
  /// Numero de aprobacion, comprobante o referencia de la transferencia.
  reference String?
  notes     String?

  receivedAt   DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  receivedById String?  @map("received_by_id") @db.Uuid

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  receivedBy User?   @relation("PagoRecibido", fields: [receivedById], references: [id])

  @@index([invoiceId])
  @@index([receivedAt])
  @@map("payments")
}

/// Objecion del asegurador a un cobro.
///
/// Es la mitad del trabajo real de cartera en Colombia y no cabe en un campo
/// de la factura: una factura puede tener varias glosas, cada una con su
/// codigo, su valor y su propio desenlace.
model Glosa {
  id        String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  invoiceId String      @map("invoice_id") @db.Uuid
  status    GlosaStatus @default(RECIBIDA)

  /// Codigo de glosa segun la Res. 3047 / 2284.
  code   String
  reason String
  amount Decimal @db.Decimal(14, 2)

  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  answeredAt     DateTime? @map("answered_at") @db.Timestamptz(3)
  answer         String?
  /// Cuanto se acepto perder. La diferencia con `amount` es lo recuperado.
  acceptedAmount Decimal?  @map("accepted_amount") @db.Decimal(14, 2)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(3)

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("GlosaCreada", fields: [createdById], references: [id])

  @@index([invoiceId])
  @@index([status])
  @@map("glosas")
}

// ═══════════════════════════════════════════════════════════════════
// INVENTARIO
// ═══════════════════════════════════════════════════════════════════

enum ProductKind {
  INSUMO
  MEDICAMENTO
  MATERIAL_QUIRURGICO
  LENTE_INTRAOCULAR
  MONTURA
  LENTE_OFTALMICO
  LENTE_CONTACTO
  OTRO
}

enum StockMoveKind {
  ENTRADA
  SALIDA
  AJUSTE
  TRASLADO_SALIDA
  TRASLADO_ENTRADA
  BAJA
}

/// Lo que la clinica guarda, gasta o vende.
model Product {
  id    String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sku   String      @unique
  name  String
  kind  ProductKind
  brand String?
  model String?
  unit  String      @default("unidad")

  /// Registro sanitario. Vender un dispositivo medico sin el es una sancion.
  invima   String?
  /// Si es false, no se puede vender ni consumir, solo ajustar a cero.
  isActive Boolean @default(true) @map("is_active")

  /// Exige lote y vencimiento en cada entrada. Un medicamento sin lote no se
  /// puede retirar del mercado ni rastrear cuando algo sale mal.
  tracksLot Boolean @default(false) @map("tracks_lot")

  /// Bajo este numero hay que reponer. Por producto; el minimo por sede va en
  /// StockLevel, porque Ibague no gasta lo mismo que Bogota.
  minQty Int @default(0) @map("min_qty")

  salePrice Decimal? @map("sale_price") @db.Decimal(14, 2)
  costPrice Decimal? @map("cost_price") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  levels             StockLevel[]
  movements          StockMovement[]
  opticalOrdersFrame OpticalOrder[]  @relation("Montura")
  opticalOrdersLens  OpticalOrder[]  @relation("LenteOftalmico")

  @@index([kind, isActive])
  @@map("products")
}

/// Existencia de un producto en una sede y, si aplica, en un lote.
///
/// Es un saldo cacheado, no la verdad: la verdad son los movimientos. Se
/// actualiza en la MISMA transaccion que el movimiento para que no puedan
/// discrepar, y se puede reconstruir sumando el libro.
model StockLevel {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId String @map("product_id") @db.Uuid
  siteId    String @map("site_id") @db.Uuid

  /// Cadena vacia, no null: un indice unico con null deja meter la misma
  /// combinacion dos veces, porque en SQL null nunca es igual a null.
  lot       String    @default("")
  expiresAt DateTime? @map("expires_at") @db.Date

  quantity Int  @default(0)
  /// Minimo especifico de esta sede. Nulo = se usa el del producto.
  minQty   Int? @map("min_qty")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id])

  @@unique([productId, siteId, lot])
  @@index([siteId, quantity])
  @@index([expiresAt])
  @@map("stock_levels")
}

/// El libro. Append-only por trigger: un movimiento borrado es un faltante
/// que nadie puede explicar.
model StockMovement {
  id        String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId String        @map("product_id") @db.Uuid
  siteId    String        @map("site_id") @db.Uuid
  kind      StockMoveKind

  lot       String    @default("")
  expiresAt DateTime? @map("expires_at") @db.Date

  /// Siempre positiva. El signo lo pone `kind`, no el numero: un menos
  /// perdido en un formulario convierte una salida en una entrada.
  quantity Int
  /// Saldo despues del movimiento. Congelado, para poder auditar sin
  /// recalcular todo el libro.
  balance  Int

  reason   String?
  /// De donde salio: cirugia, orden de optica, factura.
  refType  String?  @map("ref_type")
  refId    String?  @map("ref_id") @db.Uuid
  unitCost Decimal? @map("unit_cost") @db.Decimal(14, 2)

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product   Product @relation(fields: [productId], references: [id])
  site      Site    @relation(fields: [siteId], references: [id])
  createdBy User?   @relation("MovimientoStock", fields: [createdById], references: [id])

  @@index([productId, siteId, createdAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

// ═══════════════════════════════════════════════════════════════════
// OPTICA
// ═══════════════════════════════════════════════════════════════════

enum OpticalOrderStatus {
  TOMADA
  EN_LABORATORIO
  RECIBIDA
  ENTREGADA
  ANULADA
}

/// Formula optica. Es un dato clinico: la firma un profesional y no se edita.
///
/// Los valores se guardan como Decimal y no como texto porque hay que poder
/// compararlos: "el eje cambio 15 grados" solo es una pregunta contestable si
/// el eje es un numero.
model Prescription {
  id             String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  personId       String  @map("person_id") @db.Uuid
  professionalId String  @map("professional_id") @db.Uuid
  appointmentId  String? @map("appointment_id") @db.Uuid

  issuedAt DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  /// Vigencia. Una formula vieja montada en un lente nuevo es un lente que el
  /// paciente devuelve.
  validTo  DateTime? @map("valid_to") @db.Date

  // Ojo derecho
  odSphere   Decimal? @map("od_sphere") @db.Decimal(5, 2)
  odCylinder Decimal? @map("od_cylinder") @db.Decimal(5, 2)
  odAxis     Int?     @map("od_axis")
  odAdd      Decimal? @map("od_add") @db.Decimal(5, 2)
  odPrism    String?  @map("od_prism")

  // Ojo izquierdo
  oiSphere   Decimal? @map("oi_sphere") @db.Decimal(5, 2)
  oiCylinder Decimal? @map("oi_cylinder") @db.Decimal(5, 2)
  oiAxis     Int?     @map("oi_axis")
  oiAdd      Decimal? @map("oi_add") @db.Decimal(5, 2)
  oiPrism    String?  @map("oi_prism")

  /// Distancia interpupilar en milimetros.
  pupillaryDistance Decimal? @map("pupillary_distance") @db.Decimal(5, 1)
  lensType          String?  @map("lens_type")
  notes             String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  person       Person         @relation(fields: [personId], references: [id])
  professional Professional   @relation(fields: [professionalId], references: [id])
  appointment  Appointment?   @relation(fields: [appointmentId], references: [id])
  orders       OpticalOrder[]

  @@index([personId, issuedAt])
  @@map("prescriptions")
}

/// Orden de optica: la montura, los lentes, el laboratorio y la entrega.
model OpticalOrder {
  id     String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  number String             @unique
  status OpticalOrderStatus @default(TOMADA)

  personId       String @map("person_id") @db.Uuid
  siteId         String @map("site_id") @db.Uuid
  prescriptionId String @map("prescription_id") @db.Uuid

  frameProductId String? @map("frame_product_id") @db.Uuid
  /// Montura del paciente: no sale del inventario pero hay que registrarla.
  frameOwn       Boolean @default(false) @map("frame_own")
  frameNote      String? @map("frame_note")
  lensProductId  String? @map("lens_product_id") @db.Uuid
  lensNote       String? @map("lens_note")

  lab         String?
  /// Lo que se le prometio al paciente. Sin esto no hay forma de saber si el
  /// laboratorio esta incumpliendo.
  promisedAt  DateTime? @map("promised_at") @db.Date
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(3)
  receivedAt  DateTime? @map("received_at") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  /// Quien recibio las gafas. Puede no ser el paciente.
  deliveredTo String?   @map("delivered_to")

  /// Meses de garantia desde la entrega.
  warrantyMonths Int @default(3) @map("warranty_months")

  price     Decimal? @db.Decimal(14, 2)
  invoiceId String?  @map("invoice_id") @db.Uuid

  voidReason  String?  @map("void_reason")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  person       Person       @relation(fields: [personId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  prescription Prescription @relation(fields: [prescriptionId], references: [id])
  frameProduct Product?     @relation("Montura", fields: [frameProductId], references: [id])
  lensProduct  Product?     @relation("LenteOftalmico", fields: [lensProductId], references: [id])
  createdBy    User?        @relation("OrdenOpticaCreada", fields: [createdById], references: [id])

  @@index([status, promisedAt])
  @@index([personId])
  @@index([siteId, status])
  @@map("optical_orders")
}
