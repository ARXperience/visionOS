// ENUMS
// ═══════════════════════════════════════════════════════════════════

/// Tipos de documento de la tabla de referencia de RIPS. No es una lista
/// libre: si aqui falta uno, la factura electronica del futuro se rechaza.
enum DocumentType {
  CC
  TI
  CE
  PA
  RC
  NIT
  MS
  AS
  PE
  PT
  CN
  SC
  DE
}

/// RIPS admite I (indeterminado). No se reduce a M/F.
enum Sex {
  M
  F
  I
}

enum Zone {
  U
  R
}

enum PayerType {
  EPS
  PREPAGADA
  POLIZA
  ARL
  SOAT
  EMPRESA
  PARTICULAR
}

enum Regime {
  CONTRIBUTIVO
  SUBSIDIADO
  ESPECIAL
  EXCEPCION
  PARTICULAR
}

enum ProfessionalType {
  OFTALMOLOGO
  OPTOMETRA
  ORTOPTISTA
  ANESTESIOLOGO
  ENFERMERIA
  ESTETICA
  OTRO
}

enum ConsentPurpose {
  TRATAMIENTO_DATOS
  COMUNICACIONES_COMERCIALES
  HISTORIA_CLINICA
  IMAGENES
  TELECONSULTA
}

