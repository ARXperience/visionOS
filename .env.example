# ── Base de datos: Supabase ──────────────────────────────────────
# Connection string del proyecto (Settings -> Database).
# El endpoint AGRUPADO (puerto 6543, pgbouncer en modo transaccion) para la
# aplicacion. Prisma necesita ?pgbouncer=true ahi, o intenta usar sentencias
# preparadas que pgbouncer rechaza.
DATABASE_URL=postgresql://postgres.PROYECTO:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Las migraciones NO pasan por el pool: necesitan sesion y un lock de aviso
# que pgbouncer en modo transaccion no soporta. En Supabase es el puerto 5432
# (Session pooler o conexion directa), sin pgbouncer=true.
DIRECT_DATABASE_URL=postgresql://postgres.PROYECTO:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── API ──────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
# Se inyecta en el build; /health lo devuelve para verificar que el deploy entro.
GIT_SHA=local

JWT_SECRET=cambiar_en_produccion_minimo_32_caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar_en_produccion_otro_distinto_32_car
JWT_REFRESH_EXPIRES_IN=30d

# Lista EXPLICITA, nunca '*': con credenciales, un comodin significaria que
# cualquier pagina de internet puede llamar a la API con la sesion del
# usuario. En produccion, el dominio del panel en Vercel.
CORS_ORIGINS=http://localhost:3000,http://localhost:8777

# La cookie del refresh tiene que llegar del panel (Vercel) a la API
# (Hostinger). Solo funciona si ambos cuelgan del mismo dominio registrable:
# el punto inicial la hace valida en todos sus subdominios.
# En local se deja VACIA.
COOKIE_DOMAIN=

# ── Web ──────────────────────────────────────────────────────────
# En local queda vacia y el cliente usa /api contra el proxy del 8777.
# En Vercel: https://api.visioncolombia.com.co/api
NEXT_PUBLIC_API_URL=

# ── WhatsApp (E2) ────────────────────────────────────────────────
# Version PINNEADA sin caret a proposito: Baileys es ingenieria inversa
# y un RC distinto puede tumbar la sesion. Ver R1 del plan.
WHATSAPP_MAX_SESSIONS=4
# El gateway NO va en Hostinger: necesita un proceso vivo y permanente.
# Corre aparte y la API le habla por esta URL.
GATEWAY_URL=http://127.0.0.1:3002
# Clave AES-256-GCM del auth state de Baileys guardado en Postgres.
# Generar con: openssl rand -hex 32
WHATSAPP_AUTH_ENCRYPTION_KEY=

# ── IA (E5) ──────────────────────────────────────────────────────
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Corte duro mensual en USD: al superarlo la IA degrada a "un humano
# te responde en un momento" en vez de seguir gastando.
AI_MONTHLY_BUDGET_USD=60
